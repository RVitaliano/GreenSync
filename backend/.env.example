# Local (Mosquitto): MQTT_HOST=mosquitto, MQTT_PORT=1883, MQTT_USE_TLS=false
# EMQX Cloud: preencher host/porta/usuário/senha do cluster (ver painel do EMQX), MQTT_USE_TLS=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_SENSORES=greensync/+/sensores
MQTT_TOPIC_STATUS=greensync/+/status

FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
LOG_LEVEL=INFO

# IA (Gemini): crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite            # <-- mudou (o principal dava timeout)
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite   # <-- mudou (agora é a reserva)
GEMINI_TIMEOUT_AUDIO_S=25                     # <-- novo (áudio demora mais que texto)

# Voz da planta (TTS) e limites do áudio. Todos opcionais: sem eles valem os padrões abaixo.
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_MODEL_FALLBACK=gemini-3.8-flash-lite-tts
# TTS_VOICE=Kore
# TTS_ESTILO=simpática e carinhosa
# TTS_SAMPLE_RATE=0
# AUDIO_MAX_S=15

# Segundos sem leitura nova para o assistente tratar o dado como velho (vaso offline).
LEITURA_VELHA_APOS_S=120

# API HTTP (cabeçalho X-API-Key). Vazia = rota aberta, só para desenvolvimento.
API_KEY=

# Redis e limite de perguntas por chave de API.
# Local: redis://redis:6379/0 (o serviço "redis" do docker-compose).
# Vazia = sem Redis e SEM limite (o backend avisa no log ao iniciar).
REDIS_URL=redis://redis:6379/0
LIMITE_PERGUNTAS=10
JANELA_LIMITE_S=60

# Contexto curto da conversa (usa o mesmo Redis; sem Redis, segue sem contexto).
# CONTEXTO_TURNOS=3            # trocas lembradas (0 desliga)
# CONTEXTO_TTL_S=300           # esquece depois de 5 min sem conversa
# CONTEXTO_MAX_CHARS=300       # tamanho máximo de cada fala guardada

# --- Rega por voz e agendamento ---
REGA_DURACAO_MAX_S=15          # <-- mudou (era 10)
REGA_DURACAO_PADRAO_S=15       # <-- mudou (era 5)
# REGA_ATRASO_MAX_S=86400      # só agenda para as próximas 24 h
# REGA_INTERVALO_MIN_S=600     # mínimo entre duas regas (10 min)
# REGA_TOLERANCIA_S=300        # atrasou mais que isso (ex.: reinício)? a rega expira
# FUSO_UTC_H=-3                # horário local para "às 15h" (Brasília = -3)
# MQTT_TOPIC_COMANDOS=greensync/{device_id}/comandos