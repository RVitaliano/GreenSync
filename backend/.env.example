# Local (Mosquitto): MQTT_HOST=mosquitto, MQTT_PORT=1883, MQTT_USE_TLS=false
# EMQX Cloud: preencher host/porta/usuário/senha do cluster (ver painel do EMQX), MQTT_USE_TLS=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_SENSORES=greensync/+/sensores
MQTT_TOPIC_STATUS=greensync/+/status

FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
LOG_LEVEL=INFO