// EMQX Cloud (copie o host do painel do cluster)
#define MQTT_SERVER "HOST_DO_CLUSTER_EMQX"
#define MQTT_PORT 8883
#define MQTT_USER "esp_vaso"
#define MQTT_PASS "SENHA_DO_USUARIO_MQTT"

// Identificacao do vaso (use "vaso-teste" enquanto estiver testando)
