// TLS: 1 = nao valida o certificado (SO PARA TESTE). 0 = valida com a CA abaixo.
#define MQTT_TLS_INSEGURO 1

// Certificado da CA do broker (baixe no painel do EMQX). Usado quando MQTT_TLS_INSEGURO = 0.
#define EMQX_CA_CERT \
"-----BEGIN CERTIFICATE-----\n" \
"COLE_AQUI_O_CERTIFICADO\n" \
"-----END CERTIFICATE-----\n"

// Intervalo entre publicacoes
#define INTERVALO_PUBLICACAO_MS 20000

